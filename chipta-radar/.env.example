# ==========================================================
#  Chipta Radar — maxfiy sozlamalar. Bu fayl GitHub'ga TUSHMAYDI.
#  Bulutda (Render) bu qiymatlar "Environment" bo'limida turadi.
# ==========================================================

# --- PostgreSQL (Neon) ---
DATABASE_URL="postgresql://FOYDALANUVCHI:PAROL@HOST.neon.tech/neondb?sslmode=require"
# Jadvallar shu sxemada saqlanadi (boshqa loyihalar jadvallariga tegilmaydi)
# DB_SCHEMA=chipta_radar

# --- Telegram bot (@BotFather dan olinadi) ---
BOT_TOKEN="123456789:AA..."

# Mini App manzili (eskisi, ishlatilmaydi — bot to'liq inline).
WEBAPP_URL=""

# Botning ochiq https manzili. Render uni avtomatik beradi (RENDER_EXTERNAL_URL).
# "Akkaunt va ma'lumotlar" Web App sahifasi shu manzilning /app/account yo'lida ochiladi.
PUBLIC_URL=""

# --- Server ---
PORT=3000
NODE_ENV=development

# --- Admin panel ---
ADMIN_PASSWORD="admin123"
ADMIN_SECRET="tasodifiy-uzun-maxfiy-kalit"

# --- Shaxsiy ma'lumotlarni shifrlash (akkaunt tokeni, yo'lovchilar) ---
# 32 bayt kalit: 64 ta hex belgi yoki base64. Hosil qilish:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Berilmasa ADMIN_SECRET dan hosil qilinadi (lekin alohida kalit tavsiya etiladi).
DATA_ENCRYPTION_KEY=""

# --- Ishlab chiqish rejimi ---
# true bo'lsa Mini App'ni oddiy brauzerda (Telegramsiz) ham sinab ko'rsa bo'ladi.
ALLOW_DEV_AUTH=true

# --- eticket.railway.uz (ixtiyoriy) ---
# Sayt API uchun hisobga kirishni talab qilsa, shu yerga eticket login/parolini yozing:
RAILWAY_LOGIN=""
RAILWAY_PASSWORD=""
# Saytga so'rovlar orasidagi eng kam oraliq (ms). Saytni ortiqcha yuklamaslik uchun.
RAILWAY_MIN_INTERVAL_MS=1200

# --- Kuzatuv xizmati (Admin Paneldan ham o'zgartiriladi) ---
WATCH_INTERVAL_SEC=60
MAX_WATCHES_PER_USER=10
