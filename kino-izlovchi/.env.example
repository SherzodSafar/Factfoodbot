# ==========================================================
#  Kino Izlovchi — maxfiy sozlamalar (.env GitHub'ga tushmaydi)
# ==========================================================

# Telegram bot tokeni (@BotFather → /newbot)
BOT_TOKEN="123456789:AA..."

# Claude API kaliti (https://console.anthropic.com → API Keys)
ANTHROPIC_API_KEY="sk-ant-..."

# Ixtiyoriy: model (standart: claude-opus-5-5)
# CLAUDE_MODEL="claude-opus-5-5"

# Tavsiya etiladi: TMDB kaliti — poster, reyting, janr, platformalar uchun
# https://www.themoviedb.org/settings/api (bepul). v3 API key yoki v4 Read Access Token.
TMDB_API_KEY=""

# "Qayerda ko'rish" uchun mamlakat kodi (RU, US, UZ, ...)
WATCH_REGION="RU"

# Bir foydalanuvchiga kunlik so'rovlar soni (0 = cheksiz)
DAILY_LIMIT=30

# Bulutda (Render va h.k.) webhook uchun: xizmat manzili, masalan https://kino-izlovchi.onrender.com
# Bo'sh qolsa — polling rejimi (kompyuterda ishlatish uchun qulay).
WEBHOOK_DOMAIN=""

# Ixtiyoriy: Instagram/YouTube uchun cookies.txt matni (Netscape formati)
YTDLP_COOKIES=""
PORT=3000
