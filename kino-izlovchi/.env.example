# ==========================================================
#  Kino Izlovchi — maxfiy sozlamalar (.env GitHub'ga tushmaydi)
# ==========================================================

# Telegram bot tokeni (@BotFather → /newbot)
BOT_TOKEN="123456789:AA..."

# Google Gemini API kaliti — bepul: https://aistudio.google.com/api-keys
GEMINI_API_KEY=""

# Ixtiyoriy: modellar navbati (vergul bilan). Birinchisi band bo'lsa, keyingisiga o'tiladi.
# GEMINI_MODELS="gemini-3.5-flash,gemini-3-flash-preview,gemini-3.8-flash,gemini-3.5-flash-lite"

# Ixtiyoriy: TMDB kaliti — kartochkaga poster va reyting qo'shadi (bepul)
# https://www.themoviedb.org/settings/api
TMDB_API_KEY=""

# Bir foydalanuvchiga kunlik so'rovlar soni (0 = cheksiz)
DAILY_LIMIT=30

# Bulutda webhook uchun manzil. Render'da avtomatik olinadi (RENDER_EXTERNAL_URL).
# Bo'sh qolsa — polling rejimi (kompyuterda ishlatish uchun qulay).
WEBHOOK_DOMAIN=""
PORT=3000

# Ixtiyoriy: Instagram/YouTube uchun cookies.txt matni (Netscape formati)
YTDLP_COOKIES=""
