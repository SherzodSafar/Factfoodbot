# Shajara iBot — sozlamalar (Vercel → Project → Settings → Environment Variables)
BOT_TOKEN="123456:AA..."           # @BotFather bergan token
APP_SECRET="uzun-tasodifiy-satr"    # kodlar va sessiyalarni imzolash uchun
ADMIN_KEY="boshqa-tasodifiy-satr"   # /api/setup va /api/admin/import uchun
CRON_SECRET="yana-bir-satr"         # Vercel cron (tug'ilgan kun eslatmalari)
PUBLIC_URL="https://shajara-ibot.vercel.app"
BOT_USERNAME="Shajara_iBot"
# BLOB_READ_WRITE_TOKEN — Vercel Blob ulanganda avtomatik qo'shiladi.
# Lokal ishlaganda bo'lmasa, ma'lumotlar .data/ papkasiga yoziladi.
